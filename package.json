{
  "name": "home-orchestrator-website",
  "private": true,
  "scripts": {
    "dev": "hugo server --disableFastRender",
    "build": "hugo --minify",
    "css:watch": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./static/css/style.css --watch",
    "css:build": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./static/css/style.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
